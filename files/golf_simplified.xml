<mujoco>
    <worldbody>
		<light diffuse="1 1 1" pos="0 0 5" dir="0 0 -1"/>

		<geom type="plane" size="3 10 0.1" rgba="1 1 1 1" pos="0 -8 1"/>

        <!-- Golf player -->
		<body pos="1 0 1.2">

			<!-- Non-moving base -->
			<geom name="base" type="cylinder" size="0.15 0.2" rgba="0 0 0 1"/>

			<body pos="0 0 0.2">

				<!-- Small cylinder stand thing -->
				<geom name="stand" type="cylinder" size="0.08 0.1" rgba="0 0 0 1"/> 

				<body pos="0 0 0.1">

					<!-- Ball for the joint -->
					<geom name="ball" type="sphere" size="0.08" rgba="0 0 0 1"/>

					<body pos="0 0 0.58"> <!-- Ball radius + half height of torso -->

						<!-- Torso -->
						<geom name="torso" type="ellipsoid" size="0.25 0.35 0.5" rgba="1 1 1 1"/>
						<inertial pos="-0.5 0 0" mass="10" diaginertia="0.1 0.1 0.1"/>

						<joint name="torso_fold" pos="0 0 -0.5" axis="0 1 0" type="hinge"/>
						<joint name="torso_rotate" pos="0 0 -0.5" axis="0 0 1" type="hinge"/>

                        <body pos="0 0.25 0.3">
							<geom name="shoulder1" type="sphere" size="0.1" rgba="1 1 1 1"/>

							<body pos="-0.35 0.1 0.03" euler="90 90 0">
								<geom name="arm1" type="capsule" size="0.06 0.45" rgba="1 1 1 1"/>
                                <joint name="arm1" pos="0 0 0.35" axis="1 0 0" type="hinge"/>

                                <!-- Club -->
                                <body pos="0 0 -0.55" euler="0 0 -90">
                                    <geom name="club" type="cylinder" size="0.02 0.57" mass="1" rgba="0.4 0.4 0.4 1"/>

                                    <body>
                                        <geom name="hammer" mass="1"  type="box" size="0.04 0.02 0.15" rgba="0.4 0.4 0.4 1" euler="0 90 0" pos="-0.1  0 -0.53"/>
                                    </body>
                                </body>
							</body>
						</body>

						<!-- Head -->
						<body pos="0 0 0.65">
							<geom name="head" type="sphere" size="0.25"  rgba="1 1 1 1"/>
						</body>
					</body>
				</body>
			</body>
		</body>

        <!-- Position mega hardcoded  -->
        <body pos="-0.06 0 1.11">
		    <geom name="cylthing" type="cylinder" size="0.015 0.11" rgba="1 1 1 1"/>
		</body>
        <body pos="-0.06 0 1.5">
		    <joint type="free"/>
		    <geom name="golf_ball" type="sphere" mass="0.04593" size="0.02134" rgba="1 1 1 1"/>
		</body>
	</worldbody>

    <actuator>
        <position name="fold_motor" joint="torso_fold" kp="10000" dampratio="1"/>
        <position name="rotate_motor" joint="torso_rotate" kp="10000" dampratio="1"/>
        <position name="arm1_motor" joint="arm1" kp="10000" dampratio="1"/>
    </actuator>
</mujoco>