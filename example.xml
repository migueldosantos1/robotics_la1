<mujoco model="golf_grass">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <!-- Sky -->
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.55 0.75 0.95" rgb2="0.9 0.95 1.0" width="512" height="3072"/>

    <!-- Grass -->
    <texture name="grass_tex" type="2d" builtin="flat" rgb1="0.24 0.48 0.16" rgb2="0.30 0.58 0.20" mark="random" markrgb="0.15 0.35 0.10" random="0.25" width="512" height="512"/>
    <material name="grass_mat" texture="grass_tex" texuniform="true" texrepeat="40 40" reflectance="0" specular="0.05" shininess="0.05"/>

    <!-- Golf ball material -->
    <material name="ball_mat" rgba="0.98 0.98 0.98 1" specular="0.6" shininess="0.6"/>

    <!-- Scaled golf ball mesh -->
    <mesh name="golf_ball_mesh" file="files/golf_ball.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <light name="sun" pos="0 0 20" dir="0 0 -1" directional="true" diffuse="0.9 0.9 0.85" specular="0.2 0.2 0.2" castshadow="true"/>

    <!-- Grass floor plane at Z = 0 -->
    <geom name="floor" type="plane" size="25 25 0.1" material="grass_mat" friction="0.8 0.005 0.0001"/>

    <!-- Golf ball body starting slightly above ground (Z = 0.03 m) -->
    <body name="golf_ball" pos="0 0 0.03">
      <freejoint name="ball_free"/>
      
      <!-- Combined visual & collision mesh geom -->
      <geom name="ball_geom" type="mesh" mesh="golf_ball_mesh" material="ball_mat" mass="0.0459" friction="0.8 0.005 0.0001"/>
    </body>

    <!-- Close-up camera angle -->
    <camera name="close_up" pos="0.2 -0.2 0.1" xyaxes="0.707 0.707 0 -0.408 0.408 0.816"/>
  </worldbody>
</mujoco>