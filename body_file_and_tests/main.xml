<mujoco model="main">

    <worldbody>

        <body name="pernas" pos="0 0 0" >

            <!-- Perna esquerda: deslocada para Y=-0.1-->
            <geom type="ellipsoid" pos="0 -0.1 0.5" size="0.1 0.08 0.5" mass="14"/>

            <!-- Perna direita: deslocada para Y=0.1-->
            <geom type="ellipsoid" pos="0 0.1 0.5" size="0.1 0.08 0.5" mass="14"/>

            <!-- pelvis -->
            <geom type="cylinder" fromto="0 -0.175 0.875  0 0.175 0.875 " size="0.125" mass="10"/>

            <!-- anca-->
            <body name="anca_z" pos="0 0 1.0">
                <inertial pos="0 0 0.1" mass="0.01" diaginertia="0.0001 0.0001 0.0001"/>
                <joint name="rot_anca_z" type="hinge" axis="0 0 1" range="-80 80" damping="0.5"/>
                
                <body name="anca_y">
                    <inertial pos="0 0 0.1" mass="0.01" diaginertia="0.0001 0.0001 0.0001"/>
                    <joint name="rot_anca_y" type="hinge" axis="0 1 0" range="-15 40" damping="0.5"/>

                    <body name="anca_x" >
                        <joint name="rot_anca_x" type="hinge" axis="1 0 0" range="-30 30" damping="0.5"/>
                        <geom type="sphere" pos="0 0 0.1" size="0.1" mass="8"/>

                        <!-- o torax representa a caixa toráxica-->
                        <body name="torax" pos="0 0 0.15">
                            <geom type="ellipsoid" pos="0 0 0.225" size="0.1125 0.2 0.225" mass="13"/>
                                <geom type="cylinder" fromto="0 -0.225 0.3 0 0.225 0.3" size="0.1125"/>
                            <geom type="ellipsoid" pos="0 0 0.55" size="0.1 0.1 0.125" mass ="5"/>


                        </body>
                    </body>
                </body>            
            </body>
        </body>

    </worldbody>

</mujoco>